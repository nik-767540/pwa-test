{
  "id": "https://pwa-test-ochre-eight.vercel.app/",
  "name": "Hello World PWA",
  "short_name": "Hello World",
  "description": "A Next.js Hello World Progressive Web App",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "tech.mobifly.helloworldpwa",
      "url": "https://play.google.com/store/apps/details?id=tech.mobifly.helloworldpwa"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
